# ============================================================
# LandAI — .gitignore
# Python (FastAPI) backend + React/Vite frontend
# ============================================================

# ---------------------------
# Environment & Secrets
# ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------
# Python / Backend
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
site/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# Type checking / linting
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# SQLite test databases
*.db
*.sqlite3
backend/test_auth.db

# Cache
backend/.cache/
.cache/

# ---------------------------
# Node.js / Frontend
# ---------------------------
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Vite
*.local
.vite/

# Package manager lock files (keep package-lock.json, ignore yarn/pnpm)
yarn.lock
pnpm-lock.yaml

# ---------------------------
# Docker
# ---------------------------
.docker/

# ---------------------------
# IDE / Editor
# ---------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------
# Logs
# ---------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------
# Misc
# ---------------------------
.claude/
*.bak
*.tmp
