# ─────────────────────────────────────────────────────────────────────────────
# LAND AI — backend environment variables
# Copy to `.env` and adjust. Every ingestion setting has a safe default, so you
# only need to override what differs in your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional PostGIS spatial backend. Unset => in-memory shapely backend. ──
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/landai

# ── Real data ingestion (OpenStreetMap / open feeds) ─────────────────────────

# Master switch. When false, /api/live/* report an explicit "unavailable"
# envelope instead of making any outbound request (handy for offline / CI).
LIVE_INGESTION_ENABLED=true

# Identifying contact embedded in the outbound User-Agent. Nominatim's usage
# policy REQUIRES a valid identifying UA. Use a real ops mailbox in production
# (never a personal address — it travels on every outbound request).
INGESTION_CONTACT=ops@landai.example
# INGESTION_USER_AGENT=LandAI-Ingestion/2.0 (+https://landai.example; ops@landai.example)

# Overpass endpoints, comma-separated, tried in order (failover). These MUST be
# GLOBAL-coverage instances — a regional mirror (e.g. overpass.osm.ch hosts a
# Swiss-only extract) would silently return empty results for Indian queries.
# Override if a host is unreachable from your network, or point at a self-hosted
# Overpass for production scale.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Where cached responses live (keeps us gentle on upstream services + fast).
# INGESTION_CACHE_DIR=./.cache/ingestion

# HTTP behaviour
INGESTION_HTTP_TIMEOUT=30
INGESTION_HTTP_MAX_RETRIES=3

# Default search radius (metres) for intra-city amenities.
INGESTION_AMENITY_RADIUS_M=8000

# ── Auth / API platform ──────────────────────────────────────────────────────
# Auth/platform DB. SQLite by default (zero-setup). Point at Postgres in prod;
# falls back to DATABASE_URL if AUTH_DATABASE_URL is unset.
# AUTH_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/landai
# AUTH_DATABASE_URL=sqlite:///./landai_auth.db

# JWT secret. REQUIRED in production — if unset, an ephemeral per-process secret
# is generated and tokens do NOT survive a restart. Generate: openssl rand -base64 48
# JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Password hashing scheme (passlib). pbkdf2_sha256 (default) needs no native build.
# PASSWORD_SCHEME=pbkdf2_sha256

# Inbound API rate limiting (per-IP token bucket)
RATELIMIT_ENABLED=true
RATELIMIT_RPM=120
# RATELIMIT_BURST=120

# ── Google OAuth (real, env-gated) ───────────────────────────────────────────
# Set CLIENT_ID to enable "Sign in with Google" (Identity-Services ID-token flow).
# Add CLIENT_SECRET to also enable the authorization-code redirect flow.
# Until set, /api/auth/google returns a clear "not configured" (501).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5173      # where the OAuth callback bounces tokens back to

# ── Billing — Razorpay (real, env-gated) ─────────────────────────────────────
# Set KEY_ID + KEY_SECRET to make billing LIVE (India-first). Until set, the
# no-op provider is active and no charge can occur. WEBHOOK_SECRET verifies
# incoming webhook signatures (HMAC-SHA256); defaults to KEY_SECRET if unset.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PRICE_PRO_PAISE=99900          # ₹999/mo  (override default plan prices)
# RAZORPAY_PRICE_ENTERPRISE_PAISE=499900  # ₹4999/mo

# ── ML governance scheduler ──────────────────────────────────────────────────
# Registry snapshot + drift self-check run once at startup regardless. Set
# ENABLED=1 to also run them on a recurring background thread.
# ML_GOVERNANCE_ENABLED=0
# ML_GOVERNANCE_INTERVAL_SEC=3600
